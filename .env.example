# HonMonit Environment Configuration
# Copy this to .env and customize for your environment

# Database
# SQLite: sqlite+aiosqlite:///./honmonit.db
# PostgreSQL: postgresql+asyncpg://user:password@localhost/honmonit
DATABASE_URL=sqlite+aiosqlite:///./honmonit.db

# Security - CHANGE THIS IN PRODUCTION!
SECRET_KEY=honmonit-dev-secret-change-in-production

# Server Configuration
PORT=8000
HOST=0.0.0.0

# TLS/SSL Configuration
TLS_ENABLED=true
TLS_CERT_PATH=./certs/honmonit.crt
TLS_KEY_PATH=./certs/honmonit.key

# Optional: Use real certificates
# TLS_CERT_PATH=/etc/letsencrypt/live/honmonit.example.com/fullchain.pem
# TLS_KEY_PATH=/etc/letsencrypt/live/honmonit.example.com/privkey.pem

# Logging
LOG_LEVEL=INFO
SQL_ECHO=false

# Alerts - Default thresholds (can be overridden per-device)
DEFAULT_CPU_THRESHOLD=90
DEFAULT_RAM_THRESHOLD=85
DEFAULT_DISK_THRESHOLD=90

# Metrics retention (days, 0 = unlimited)
METRICS_RETENTION_DAYS=0

# Feature flags
ENABLE_AUTH=true
ENABLE_ALERTS=true
ENABLE_METRICS_HISTORY=true
